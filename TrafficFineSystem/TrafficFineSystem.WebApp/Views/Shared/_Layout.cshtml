@using System.IdentityModel.Tokens.Jwt
@{
    string currentUserId = "";
    var token = Context.Request.Cookies["AuthToken"];
    if (!string.IsNullOrEmpty(token))
    {
        var handler = new JwtSecurityTokenHandler();
        if (handler.CanReadToken(token))
        {
            var jwt = handler.ReadJwtToken(token);
            // Firebase genelde "user_id" veya "sub" claim'i içinde UID tutar
            currentUserId = jwt.Claims.FirstOrDefault(c => c.Type == "user_id" || c.Type == "sub")?.Value ?? "";
        }
    }
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TrafficFineSystem.WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/TrafficFineSystem.WebApp.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <!-- Sol üstteki ana başlık -->
            <a class="navbar-brand" asp-area="" asp-controller="Fines" asp-action="Index">Trafik Ceza Yönetimi</a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <!-- Sadece bizim menülerimiz -->
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Fines" asp-action="Index">Cezalar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Vehicles" asp-action="Index">Araçlar</a>
                    </li>
                </ul>
                
                <!-- İleride Firebase giriş/çıkış butonunu buraya koyacağız -->
                <ul class="navbar-nav">
                    @if (Context.Request.Cookies.ContainsKey("AuthToken"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-danger" asp-area="" asp-controller="Auth" asp-action="Logout" onclick="triggerTabSync()">Çıkış Yap</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-primary" asp-area="" asp-controller="Auth" asp-action="Login">Giriş Yap</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted mt-5">
    <div class="container text-center">
        &copy; @DateTime.Now.Year - Trafik Ceza Yönetim Sistemi
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<!-- Microsoft SignalR Kütüphanesi -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
        // C#'tan gelen User ID'yi JS tarafına alıyoruz
        const currentUserId = '@currentUserId';

        // DİKKAT: Buradaki portu (XXXX) Audit.API projenin çalıştığı port ile değiştirmelisin!
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("http://localhost:5297/notificationHub") 
            .withAutomaticReconnect()
            .build();

        // 1. MEVCUT: Cezalar için dinleyici
        connection.on("ReceiveFineNotification", function (message) {
            console.log("Sistemde bir değişiklik oldu...", message);
            if (!window.location.href.includes("Details")) {
                window.location.reload();
            }
        });

        // 2. MEVCUT: Araçlar için dinleyici
        connection.on("ReceiveVehicleNotification", function (message) {
            console.log("Sisteme yeni bir araç eklendi...", message);
            if (window.location.href.includes("Vehicles") && !window.location.href.includes("Create")) {
                window.location.reload();
            }
        });

        // 3. YENİ: Merkezden gelen "Zorla Çıkış" emrini dinleyen radyo
        connection.on("ForceLogout", function () {
            console.log("Başka bir cihazdan/sekmeden çıkış yapıldı. Güvenlik için oturum kapatılıyor...");
            window.location.href = '/Auth/Login'; 
        });

        // Bağlantıyı başlat
        connection.start().then(function () {
            console.log("WebSocket bağlantısı başarıyla kuruldu! Gözetleme devrede.");
            
            // Eğer kullanıcı giriş yapmışsa (ID boş değilse), merkeze "Ben buradayım" de
            if (currentUserId !== "") {
                connection.invoke("RegisterUser", currentUserId);
            }
            
        }).catch(function (err) {
            return console.error("WebSocket bağlantı hatası: ", err.toString());
        });

        // 4. YENİ: Navbar'daki 'Çıkış Yap' butonuna basıldığında bu fonksiyon çalışır
        function triggerTabSync() {
            if (currentUserId !== "") {
                // Merkeze "Benim diğer tüm cihazlarımdaki sekmeleri kapat" sinyali gönderir
                connection.invoke("NotifyLogout", currentUserId);
            }
        }
</script>

</body>
</html>