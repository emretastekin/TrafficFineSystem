@model TrafficFineSystem.WebApp.Models.TrafficFineViewModel

@{
    ViewData["Title"] = "Yeni Ceza Kes";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Yeni Trafik Cezası Oluştur</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        
                        <!-- API tarafında varsa diye Hata Mesajları Bölümü -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="VehicleId" class="form-label">Araç ID</label>
                            <input asp-for="VehicleId" class="form-control" type="number" placeholder="Örn: 1" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label">Ceza Tutarı (₺)</label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" placeholder="Örn: 1500.50" required />
                        </div>

                        <!-- Tarih ve Durumu (Status) formdan almıyoruz, Core.API bunu otomatik "Yeni" ve "Şu anki tarih" olarak kendisi atıyor. -->

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Kaydet ve Cezayı Kes</button>
                            <a asp-action="Index" class="btn btn-secondary">İptal et ve Geri dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>