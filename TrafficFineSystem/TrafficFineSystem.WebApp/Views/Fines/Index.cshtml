@model List<TrafficFineSystem.WebApp.Models.TrafficFineViewModel>

@{
    ViewData["Title"] = "Trafik Cezaları";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Trafik Cezası Listesi</h2>
        <a asp-controller="Fines" asp-action="Create" class="btn btn-primary">+ Yeni Ceza Kes</a>
    </div>

    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
        <tr>
            <th>Ceza ID</th>
            <th>Araç ID</th>
            <th>Tutar</th>
            <th>Tarih</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var fine in Model)
            {
                <tr>
                    <td>@fine.Id</td>
                    <td>@fine.VehicleId</td>
                    <td>@fine.Amount.ToString("C")</td>
                    <td>@fine.IssueDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (fine.Status == 1) { <span class="badge bg-warning text-dark">Yeni</span> }
                        else if (fine.Status == 2) { <span class="badge bg-success">Ödendi</span> }
                        else { <span class="badge bg-danger">İptal</span> }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-info">Detay</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Sistemde henüz kayıtlı ceza bulunmuyor.</td>
            </tr>
        }
        </tbody>
    </table>
</div>