@model TrafficFineSystem.WebApp.Models.TrafficFineViewModel

@{
    ViewData["Title"] = "Ceza Detayı";
}



<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Ceza Detayları (Ceza ID: @Model.Id)</h4>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Araç ID:</div>
                <div class="col-md-9">@Model.VehicleId</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Ceza Tutarı:</div>
                <div class="col-md-9 text-danger fw-bold">@Model.Amount.ToString("C")</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Kesim Tarihi:</div>
                <div class="col-md-9">@Model.IssueDate.ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Mevcut Durum:</div>
                <div class="col-md-9" id="status-badge">
                    @if (Model.Status == 1) { <span class="badge bg-secondary fs-6">Yeni</span> }
                    else if (Model.Status == 2) { <span class="badge bg-warning text-dark fs-6">Onay Bekliyor</span> }
                    else if (Model.Status == 3) { <span class="badge bg-success fs-6">Tamamlandı (Ödendi)</span> }
                    else { <span class="badge bg-danger fs-6">İptal Edildi</span> }
                </div>
            </div>

            <hr />
            
            
            @if (ViewBag.IsAdmin == true)
            {
                <h5 class="text-secondary">Durum Güncelle (İşlem Hiyerarşisi)</h5>
                <p class="text-muted small">Cezanın güncel durumunu buradan değiştirebilirsiniz. Tamamlanan veya İptal edilen işlemler kilitlenir.</p>
            }
            
            
            <div class="d-flex gap-2 mt-3" id="action-buttons">
                <!-- 1. Aşama: Memur Onaya Gönderir (Eğer durum Yeni ise görünür) -->
                <button type="button" class="btn btn-primary" id="btn-send-approval" onclick="updateStatusAjax(@Model.Id, 2, 'Yönetici onayı talep edildi.')" style="display: @(Model.Status == 1 ? "inline-block" : "none")">Onaya Gönder</button>
                
                <!-- 2. Aşama: Yönetici Onaylar (Tahsil Eder) (Eğer durum Onay Bekliyor ise görünür) -->
                <button type="button" class="btn btn-success" id="btn-pay" onclick="updateStatusAjax(@Model.Id, 3, 'Ceza onaylandı ve tahsil edildi.')" style="display: @(Model.Status == 2 ? "inline-block" : "none")">Onayla (Tahsil Et)</button>
                
                <!-- İptal Etme: Durum 1 veya 2'deyken yapılabilir. 3 veya 4'te ise buton gizlenir -->
                <button type="button" class="btn btn-danger" id="btn-cancel" onclick="cancelFine(@Model.Id)" style="display: @(Model.Status == 1 || Model.Status == 2 ? "inline-block" : "none")">Cezayı İptal Et</button>
                
                <!-- SADECE VERİTABANINDA YETKİSİ OLAN ADMİNLER GÖREBİLİR -->
                @if (ViewBag.IsAdmin == true)
                {
                    <button type="button" class="btn btn-warning text-dark" id="btn-restart" onclick="updateStatusAjax(@Model.Id, 1, 'Admin tarafından süreç yeniden başlatıldı.')" style="display: @(Model.Status == 3 || Model.Status == 4 ? "inline-block" : "none")">Süreci Baştan Başlat (Yetkili)</button>
                }
                
                <a asp-action="Index" class="btn btn-secondary ms-auto">Listeye Dön</a>
            </div>
            
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Onay ve İşlem Geçmişi</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>İşlem Tarihi</th>
                    <th>İşlem Tipi / Durum</th>
                    <th>Açıklama / Ret Nedeni</th>
                    <th>Kullanıcı (UID)</th>
                </tr>
            </thead>
            <tbody id="history-table-body">
                @if (ViewBag.Histories != null && ((List<TrafficFineSystem.WebApp.Models.FineHistoryViewModel>)ViewBag.Histories).Any())
                {
                    foreach (var history in (List<TrafficFineSystem.WebApp.Models.FineHistoryViewModel>)ViewBag.Histories)
                    {
                        <tr>
                            <td>@history.ProcessDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>
                                @if (history.NewStatus == 4)
                                {
                                    <span class="badge bg-danger">İptal Edildi</span>
                                }
                                else if (history.NewStatus == 3)
                                {
                                    <span class="badge bg-success">Tamamlandı</span>
                                }
                                else if (history.NewStatus == 2)
                                {
                                    <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Yeni</span>
                                }
                            </td>
                            <td class="text-wrap" style="max-width: 300px;">@history.Reason</td>
                            <td><small class="text-muted">@history.UserId</small></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3">Bu ceza için henüz bir işlem geçmişi bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function cancelFine(id) {
            const reason = prompt("Lütfen cezanın iptal/ret nedenini giriniz:");
            if (reason === null || reason.trim() === "") {
                alert("İşlem durduruldu! Ret işlemi için bir neden belirtmek zorunludur.");
                return;
            }
            // İptal statüsü artık 4 numara oldu.
            await updateStatusAjax(id, 4, reason);
        }

        async function updateStatusAjax(id, newStatus, reason = "") {
            document.querySelectorAll('#action-buttons button').forEach(b => b.disabled = true);

            const formData = new FormData();
            formData.append('id', id);
            formData.append('newStatus', newStatus);
            formData.append('reason', reason);

            try {
                const response = await fetch('/Fines/UpdateStatus', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    const statusDiv = document.getElementById('status-badge');
                    
                    if (newStatus === 1) {
                        statusDiv.innerHTML = '<span class="badge bg-secondary fs-6">Yeni</span>';
                    } else if (newStatus === 2) {
                        statusDiv.innerHTML = '<span class="badge bg-warning text-dark fs-6">Onay Bekliyor</span>';
                    } else if (newStatus === 3) {
                        statusDiv.innerHTML = '<span class="badge bg-success fs-6">Tamamlandı (Ödendi)</span>';
                    } else if (newStatus === 4) {
                        statusDiv.innerHTML = '<span class="badge bg-danger fs-6">İptal Edildi</span>';
                    }

                    document.getElementById('btn-send-approval').style.display = newStatus === 1 ? 'inline-block' : 'none';
                    document.getElementById('btn-pay').style.display = newStatus === 2 ? 'inline-block' : 'none';
                    document.getElementById('btn-cancel').style.display = (newStatus === 1 || newStatus === 2) ? 'inline-block' : 'none';

                    // YENİ BUTONUN GÖRÜNÜRLÜK AYARI
                    const btnRestart = document.getElementById('btn-restart');
                    if (btnRestart) {
                        btnRestart.style.display = (newStatus === 3 || newStatus === 4) ? 'inline-block' : 'none';
                    }
                    
                    
                } else {
                    alert("Hata: " + result.message);
                }
            } catch (error) {
                console.error("İstek atılırken hata:", error);
                alert("Sistemle bağlantı kurulamadı.");
            } finally {
                document.querySelectorAll('#action-buttons button').forEach(b => b.disabled = false);
            }
        }

        async function refreshHistoryTable() {
            const fineId = @Model.Id;
            try {
                const response = await fetch(`http://localhost:5297/api/Histories/fine/${fineId}`);
                if (response.ok) {
                    const histories = await response.json();
                    const tbody = document.getElementById('history-table-body');
                    tbody.innerHTML = ''; 

                    if (histories && histories.length > 0) {
                        histories.forEach(h => {
                            const dateObj = new Date(h.processDate);
                            const formattedDate = dateObj.toLocaleString('tr-TR');

                            let badge = '';
                            if (h.newStatus === 4) {
                                badge = '<span class="badge bg-danger">İptal Edildi</span>';
                            } else if (h.newStatus === 3) {
                                badge = '<span class="badge bg-success">Tamamlandı</span>';
                            } else if (h.newStatus === 2) {
                                badge = '<span class="badge bg-warning text-dark">Onay Bekliyor</span>';
                            } else {
                                badge = `<span class="badge bg-secondary">Yeni</span>`;
                            }

                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td>${formattedDate}</td>
                                <td>${badge}</td>
                                <td class="text-wrap" style="max-width: 300px;">${h.reason}</td>
                                <td><small class="text-muted">${h.userId}</small></td>
                            `;
                            tbody.appendChild(tr);
                        });
                    }
                }
            } catch (error) {
                console.error("Geçmiş güncellenemedi:", error);
            }
        }
    </script>
}