@model TrafficFineSystem.WebApp.Models.TrafficFineViewModel

@{
    ViewData["Title"] = "Ceza Detayı";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Ceza Detayları (Ceza ID: @Model.Id)</h4>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Araç ID:</div>
                <div class="col-md-9">@Model.VehicleId</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Ceza Tutarı:</div>
                <div class="col-md-9 text-danger fw-bold">@Model.Amount.ToString("C")</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Kesim Tarihi:</div>
                <div class="col-md-9">@Model.IssueDate.ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3 fw-bold">Mevcut Durum:</div>
                <div class="col-md-9" id="status-badge">
                    @if (Model.Status == 1) { <span class="badge bg-warning text-dark fs-6">Yeni</span> }
                    else if (Model.Status == 2) { <span class="badge bg-success fs-6">Ödendi</span> }
                    else { <span class="badge bg-danger fs-6">İptal Edildi</span> }
                </div>
            </div>

            <hr />
            <h5 class="text-secondary">Durum Güncelle</h5>
            <p class="text-muted small">Cezanın güncel durumunu buradan değiştirebilirsiniz. (Bu işlem Kafka üzerinden arka planda loglanacaktır).</p>
            
            <div class="d-flex gap-2 mt-3" id="action-buttons">
                <!-- Durum 1 (Yeni) değilse 'Geri Al' butonunu göster -->
                <button type="button" class="btn btn-warning text-dark" id="btn-new" onclick="updateStatusAjax(@Model.Id, 1)" style="display: @(Model.Status == 1 ? "none" : "block")">Geri Al (Yeni)</button>
                
                <!-- Durum 2 (Ödendi) değilse 'Ödendi' butonunu göster -->
                <button type="button" class="btn btn-success" id="btn-pay" onclick="updateStatusAjax(@Model.Id, 2)" style="display: @(Model.Status == 2 ? "none" : "block")">Tahsil Edildi (Ödendi)</button>
                
                <!-- Durum 3 (İptal) değilse 'İptal' butonunu göster -->
                <button type="button" class="btn btn-danger" id="btn-cancel" onclick="cancelFine(@Model.Id)" style="display: @(Model.Status == 3 ? "none" : "block")">Cezayı İptal Et</button>
                
                <a asp-action="Index" class="btn btn-secondary ms-auto">Listeye Dön</a>
            </div>
            
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Onay ve İşlem Geçmişi</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>İşlem Tarihi</th>
                    <th>İşlem Tipi</th>
                    <th>Açıklama / Ret Nedeni</th>
                    <th>Kullanıcı (UID)</th>
                </tr>
            </thead>
            <tbody id="history-table-body">
                @if (ViewBag.Histories != null && ((List<TrafficFineSystem.WebApp.Models.FineHistoryViewModel>)ViewBag.Histories).Any())
                {
                    foreach (var history in (List<TrafficFineSystem.WebApp.Models.FineHistoryViewModel>)ViewBag.Histories)
                    {
                        <tr>
                            <td>@history.ProcessDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>
                                @if (history.ProcessType.Contains("İptal") || history.NewStatus == 3)
                                {
                                    <span class="badge bg-danger">İptal Edildi</span>
                                }
                                else if (history.NewStatus == 2)
                                {
                                    <span class="badge bg-success">Ödendi</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">@history.ProcessType</span>
                                }
                            </td>
                            <!-- İŞTE GİRDİĞİN İPTAL NEDENİ BURADA YAZACAK! -->
                            <td class="text-wrap" style="max-width: 300px;">@history.Reason</td>
                            <td><small class="text-muted">@history.UserId</small></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3">Bu ceza için henüz bir işlem geçmişi bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



@section Scripts {
    <script>
        // İptal butonuna basılınca çalışacak özel metot
        async function cancelFine(id) {
            // Kullanıcıdan iptal nedenini girmesini istiyoruz
            const reason = prompt("Lütfen cezanın iptal/ret nedenini giriniz:");

            // Eğer iptal tuşuna basar veya boş bırakırsa işlemi durdur
            if (reason === null || reason.trim() === "") {
                alert("İşlem durduruldu! Ret işlemi için bir neden belirtmek zorunludur.");
                return;
            }

            // Nedeni aldıysak ana fonksiyona gönder
            await updateStatusAjax(id, 3, reason);
        }

        // Ana AJAX güncelleme metodu (reason parametresi eklendi)
        async function updateStatusAjax(id, newStatus, reason = "") {
            document.querySelectorAll('#action-buttons button').forEach(b => b.disabled = true);

            const formData = new FormData();
            formData.append('id', id);
            formData.append('newStatus', newStatus);
            formData.append('reason', reason); // YENİ: Nedeni backend'e yolluyoruz

            try {
                const response = await fetch('/Fines/UpdateStatus', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    const statusDiv = document.getElementById('status-badge');
                    if (newStatus === 1) {
                        statusDiv.innerHTML = '<span class="badge bg-warning text-dark fs-6">Yeni</span>';
                    } else if (newStatus === 2) {
                        statusDiv.innerHTML = '<span class="badge bg-success fs-6">Ödendi</span>';
                    } else if (newStatus === 3) {
                        statusDiv.innerHTML = '<span class="badge bg-danger fs-6">İptal Edildi</span>';
                    }

                    document.getElementById('btn-new').style.display = newStatus === 1 ? 'none' : 'block';
                    document.getElementById('btn-pay').style.display = newStatus === 2 ? 'none' : 'block';
                    document.getElementById('btn-cancel').style.display = newStatus === 3 ? 'none' : 'block';

                } else {
                    alert("Hata: " + result.message);
                }
            } catch (error) {
                console.error("İstek atılırken hata:", error);
                alert("Sistemle bağlantı kurulamadı.");
            } finally {
                document.querySelectorAll('#action-buttons button').forEach(b => b.disabled = false);
            }
        }

        // SignalR tetiklediğinde arka planda sadece tabloyu yenileyen efsanevi fonksiyon
        async function refreshHistoryTable() {
            const fineId = @Model.Id;
            try {
                // Audit.API'den taze veriyi çekiyoruz (Port 5297)
                const response = await fetch(`http://localhost:5297/api/Histories/fine/${fineId}`);
                if (response.ok) {
                    const histories = await response.json();
                    const tbody = document.getElementById('history-table-body');
                    tbody.innerHTML = ''; // Eski verileri temizle

                    if (histories && histories.length > 0) {
                        histories.forEach(h => {
                            // C#'tan gelen tarihi JS ile formatla
                            const dateObj = new Date(h.processDate);
                            const formattedDate = dateObj.toLocaleString('tr-TR');

                            // Duruma göre Badge rengini ayarla
                            let badge = '';
                            if (h.processType.includes('İptal') || h.newStatus === 3) {
                                badge = '<span class="badge bg-danger">İptal Edildi</span>';
                            } else if (h.newStatus === 2) {
                                badge = '<span class="badge bg-success">Ödendi</span>';
                            } else {
                                badge = `<span class="badge bg-info text-dark">${h.processType}</span>`;
                            }

                            // Yeni satırı oluştur ve tabloya ekle
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td>${formattedDate}</td>
                                <td>${badge}</td>
                                <td class="text-wrap" style="max-width: 300px;">${h.reason}</td>
                                <td><small class="text-muted">${h.userId}</small></td>
                            `;
                            tbody.appendChild(tr);
                        });
                    }
                }
            } catch (error) {
                console.error("Geçmiş güncellenemedi:", error);
            }
        }
    </script>
}