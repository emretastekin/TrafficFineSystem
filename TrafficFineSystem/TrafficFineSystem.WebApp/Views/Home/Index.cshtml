@model TrafficFineSystem.WebApp.Models.DashboardViewModel

@{
    ViewData["Title"] = "Gösterge Paneli";
}

<div class="container-fluid mt-4">
    <h2 class="mb-4 text-secondary">Sistem Özeti</h2>

    <!-- İstatistik Kartları -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-5 g-4 mb-5">
        <div class="col">
            <div class="card shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Tahsil Edilen</h5>
                    <h3 class="fw-bold">@Model.TotalPaidAmount.ToString("C")</h3>
                    <small>Tamamlanan cezalar</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 bg-warning text-dark h-100">
                <div class="card-body">
                    <h5 class="card-title">Onay Bekleyen</h5>
                    <h3 class="fw-bold">@Model.PendingApprovals</h3>
                    <small>Yönetici onayı bekliyor</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 bg-secondary text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Yeni Kesilen</h5>
                    <h3 class="fw-bold">@Model.NewFines</h3>
                    <small>İşlem görmemiş cezalar</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 bg-danger text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">İptal Edilen</h5>
                    <h3 class="fw-bold">@Model.CanceledFines</h3>
                    <small>Reddedilen işlemler</small>
                </div>
            </div>
        </div>
        <!-- YENİ EKLENEN ARAÇ KARTI -->
        <div class="col">
            <div class="card shadow-sm border-0 bg-info text-white h-100">
                <div class="card-body">
                    <h5 class="card-title">Kayıtlı Araçlar</h5>
                    <h3 class="fw-bold">@Model.TotalVehicles</h3>
                    <small>Sisteme kayıtlı araçlar</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafikler ve Hızlı İşlemler -->
    <div class="row">
        <!-- 1. Grafik: Cezalar -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <h5 class="text-secondary">Ceza Durum Dağılımı</h5>
                </div>
                <div class="card-body d-flex justify-content-center">
                    <div style="width: 250px; height: 250px;">
                        <canvas id="fineStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 2. Grafik: Araçlar (YENİ) -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <h5 class="text-secondary">Araç Tipi Dağılımı</h5>
                </div>
                <div class="card-body d-flex justify-content-center">
                    <div style="width: 250px; height: 250px;">
                        <canvas id="vehicleTypeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Hızlı Menü -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <h5 class="text-secondary">Hızlı Menü</h5>
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <a asp-controller="Fines" asp-action="Index" class="btn btn-outline-primary btn-lg w-100 text-start">
                        <i class="bi bi-card-list"></i> Tüm Cezaları Görüntüle
                    </a>
                    <a asp-controller="Fines" asp-action="Create" class="btn btn-outline-info btn-lg w-100 text-start">
                        <i class="bi bi-plus-circle"></i> Yeni Ceza Kes
                    </a>
                    <a asp-controller="Vehicles" asp-action="Index" class="btn btn-outline-secondary btn-lg w-100 text-start">
                        <i class="bi bi-car-front"></i> Araç Yönetimi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js Kütüphanesi -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('fineStatusChart').getContext('2d');
            
            // C#'tan gelen Model verilerini JavaScript'e alıyoruz
            const data = {
                labels: ['Tahsil Edilen', 'Onay Bekleyen', 'Yeni', 'İptal Edilen'],
                datasets: [{
                    data: [@Model.TotalPaidAmount > 0 ? 1 : 0, @Model.PendingApprovals, @Model.NewFines, @Model.CanceledFines], // Sadece görsel amaçlı adetleri basıyoruz. Tahsilatı göstermek için ayrı bir yapı kurabiliriz ama şimdilik sayılar üzerinden gidelim.
                    backgroundColor: [
                        '#198754', // Success
                        '#ffc107', // Warning
                        '#6c757d', // Secondary
                        '#dc3545'  // Danger
                    ],
                    borderWidth: 0
                }]
            };

            // Sayıları doğru göstermek için data dizisini ezelim (Tahsilatı değil adeti grafiğe verelim)
            // (Tahsilat miktarını grafiğe koymak dengesiz yapar, bu yüzden sadece adetleri göstermek daha şıktır.
            // Ama bizde tahsil edilen ceza adeti yok, o yüzden onu şimdilik statik bir değere veya basit bir hesaba bağlayabilirsin. 
            // Burada basitlik adına elimizdeki istatistikleri kullanıyoruz).
            
            // Gerçekten adetleri basmak için Core.API'ye "PaidCount" eklemek en doğrusu olur. 
            // Şimdilik grafiğin çalıştığını göstermek için bu değerlerle başlatıyoruz:
            data.datasets[0].data = [
                @Model.PaidFinesCount,
                @Model.PendingApprovals,
                @Model.NewFines,
                @Model.CanceledFines
            ];

            new Chart(ctx, {
                type: 'doughnut',
                data: data,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });



            // --- 2. GRAFİK: ARAÇ TİPİ DAĞILIMI ---
            const vehicleCtx = document.getElementById('vehicleTypeChart').getContext('2d');

            // C#'taki Dictionary verilerini JS dizilerine çeviriyoruz
            const vehicleLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehicleTypeStats.Keys));
            const vehicleData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehicleTypeStats.Values));

            new Chart(vehicleCtx, {
                type: 'pie', // Bunu 'pie' (tam pasta) yaptık, cezalar doughnut kalabilir
                data: {
                    labels: vehicleLabels,
                    datasets: [{
                        data: vehicleData,
                        backgroundColor: [
                            '#0dcaf0', // Info (Mavi)
                            '#fd7e14', // Turuncu
                            '#6610f2', // Mor
                            '#20c997'  // Turkuaz
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
            
        });
    </script>
}